# ── md2jira-previewer environment variables ───────────────────────────────────
#
# Copy this file to .env (gitignored) and fill in the values for your
# deployment. All variables are optional — the app works without them.
#
# VITE_ prefix is required so Vite exposes them to the browser bundle.

# Public URL where error reports are sent (POST, JSON body: { message, stack }).
# When empty, reportError() logs to console only.
VITE_ERROR_URL=

# Canonical origin of the deployed app (e.g. https://md2jira.app).
# Used to build the ?md= deep-link share URL. Defaults to window.location.origin.
VITE_CANONICAL_URL=
