# ── Web Vitals reporting ──────────────────────────────────────────────────────
#
# When set, Core Web Vitals (CLS, INP, LCP, FCP, TTFB) are POSTed via
# navigator.sendBeacon to this URL as JSON: { name, value, id }
#
# Leave unset to disable production reporting (metrics are still logged to
# console.debug in development regardless of this variable).
#
# Examples:
#   VITE_VITALS_URL=https://your-analytics.example.com/vitals
#   VITE_VITALS_URL=/api/vitals
#
# VITE_VITALS_URL=

# ── Deployment ───────────────────────────────────────────────────────────────
#
# Base URL for the app. Set this when deploying to a subdirectory (e.g. GitHub
# Pages project site at /md2jira-previewer/). Must end with a slash.
# Defaults to '/' for root deployments.
#
# VITE_BASE_URL=/md2jira-previewer/

# Canonical URL injected into <link rel="canonical"> by the canonicalUrlPlugin
# in vite.config.ts at build time. Set this to the full URL of your deployment
# when forking or self-hosting. Falls back to the default GitHub Pages URL.
# Do NOT include a trailing slash.
#
# VITE_CANONICAL_URL=https://example.com/md2jira

# ── Error reporting ──────────────────────────────────────────────────────────
#
# When set, render errors caught by ErrorBoundary are POSTed via
# navigator.sendBeacon to this URL as JSON:
#   { name, message, stack, componentStack, url, timestamp }
#
# Use any endpoint that accepts a POST with Content-Type: application/json.
# Leave unset to disable production error reporting (errors still log to console).
#
# Examples:
#   VITE_ERROR_URL=https://your-error-collector.example.com/errors
#   VITE_ERROR_URL=/api/errors
#
# VITE_ERROR_URL=

# ── Feature flags ─────────────────────────────────────────────────────────────
#
# Set to 'false' to disable the TipTap WYSIWYG editor in the ADF output panel.
# Useful for lightweight deployments or E2E tests that don't need rich editing.
#
# VITE_ENABLE_WYSIWYG=true
