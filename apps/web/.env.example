# -- md2jira web app environment variables --------------------------------------
# Copy this file to .env.local and fill in the values you need.
# None of these are required for local development.
# See apps/web/vite.config.ts for how each variable is consumed at build time.

# Canonical URL injected into <link rel="canonical"> at build time.
# Used by the canonicalUrlPlugin in vite.config.ts.
# Leave empty to keep the default GitHub Pages URL in index.html.
# Example: https://md2jira.example.com
VITE_CANONICAL_URL=

# Sub-path base when deploying under a non-root path.
# Must start with '/' and end without '/'. Defaults to '/'.
# Example: /md2jira
VITE_BASE_URL=/

# POST endpoint for render errors caught by ErrorBoundary and global handlers.
# Errors are delivered via navigator.sendBeacon as application/json.
# The ?md= query param (user-authored Markdown) is stripped before reporting
# to avoid leaking user content to third-party collectors (OWASP A09).
# Leave empty to disable error reporting in production.
# Example: https://errors.example.com/collect
VITE_ERROR_URL=

# POST endpoint for Core Web Vitals metrics (CLS, INP, LCP, FCP, TTFB).
# Metrics are delivered via navigator.sendBeacon as application/json.
# Leave empty to log to console only (development) or disable entirely.
# Example: https://vitals.example.com/collect
VITE_VITALS_URL=
